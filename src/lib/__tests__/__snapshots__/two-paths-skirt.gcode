; ============================================================
; BarroCode — Lissajous G-code Generator
; ============================================================
; Lissajous amp N / T   : 0 / 0 mm
; Lissajous wl  N / T   : 20 / 20 mm
; Lissajous delta        : 0.0°
; Phase offset           : 0.0°
; Phase shift / layer    : 0.0°
; Layer height           : 2.5 mm
; Number of layers       : 2
; Nozzle Z offset        : 1 mm
; Soft join              : false (transition 10 mm)
; Scale factor           : 1
; Pivot from part centre : 0 / 0 mm
; Scale X / Y            : 1 / 1
; Rotation               : 0°
; Origin X / Y           : 0 / 0 mm
; Flip Y                 : false
; Z-hop height / radius  : 0 / 3 mm
; Skirt threshold        : 5 mm
; Print speed            : 600 mm/min
; Travel speed           : 1500 mm/min
; Generate E             : true
; Extrusion multiplier   : 0.05
; ============================================================

G21       ; mm units
G90       ; absolute positioning
M82       ; absolute extrusion
G92 E0    ; reset E

G1 Z20.000 F1500  ; safe Z

; --- Priming ---
G1 X0.000 Y10.000 F1500
G1 Z1.000 F1500

G1 X20.000 Y10.000 E1.000 F600
G1 Z20.000 F1500
; --- End priming ---


